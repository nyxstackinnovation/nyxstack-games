{
  "redirects": [
    { "source": "/breakpoint-zero", "destination": "/breakpoint-zero/", "permanent": true }
  ],
  "rewrites": [
    { "source": "/breakpoint-zero/", "destination": "https://breakpoint-zero.vercel.app/" },
    { "source": "/breakpoint-zero/:path*", "destination": "https://breakpoint-zero.vercel.app/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
